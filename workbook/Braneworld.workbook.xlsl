workbook Braneworld version "0.1"
namespace neuromindmodel.braneworld

pipeline Observe -> Encode -> Retrieve -> Reason -> Plan -> Execute -> Store

module cortex   source "../braneworld/cortex.py"
module memory   source "../braneworld/hippocampus.py"
module synapse  source "../braneworld/synapse.py"
module planner  source "../braneworld/planner.py"
module vision   source "Vision.workbook.xlsl"
module world    source "WorldModel.workbook.xlsl"

state workspace {
  perception
  tokens
  memories
  world_state
  plan
  result
}

entry run(input) {
  perception = perception.observe(input)
  tokens = tokenizer.encode(perception)
  memories = memory.retrieve(tokens)
  world_state = world.update(perception, memories)
  plan = planner.plan(tokens, memories, world_state)
  result = executor.run(plan)
  memory.store(tokens, result)
  return result
}
